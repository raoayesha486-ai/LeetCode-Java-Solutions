import java.util.Scanner;
class Main {
public static int firstOccurance(int[] arr,int element,int index){
    if(index==arr.length) return -1;
    if(arr[index]==element) return index;
    return firstOccurance(arr,element,index+1);
}

    public static void main(String[] args) {
    int [] arr={1,2,3,4,5,6};
    int element=4;
    System.out.print(firstOccurance(arr,element,0));
    }
}
