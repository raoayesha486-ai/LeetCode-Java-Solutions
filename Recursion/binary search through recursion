import java.util.Scanner;
class Main {
public static int binarySearch(int[] arr,int element,int low,int high){
    if(low>high) return -1;
    int mid=(low+high)/2;
    if(arr[mid]==element) return mid;
    if(arr[mid]<element) return binarySearch(arr,element,mid+1,high);
    return binarySearch(arr,element,low,mid-1);
}
    public static void main(String[] args) {
   int arr[] ={1,3,5,7,9};
   int element=7;
    int answer=binarySearch(arr,element,0,arr.length-1);
    System.out.print(answer);
    }
}
