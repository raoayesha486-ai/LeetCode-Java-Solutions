import java.util.Scanner;
class Main {
public static int uniquePath(int m,int n){
    if(n==1 || m==1) return 1;
    return uniquePath(m-1,n)+uniquePath(n-1,m);
}
    
    public static void main(String[] args) {
    int m=3;
    int n=7;
    int answer=uniquePath(m,n);
    System.out.print(answer);
    }
}
