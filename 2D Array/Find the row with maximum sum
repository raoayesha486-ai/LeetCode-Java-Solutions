
class Main {
    public static void main(String[] args) {
    int [][]arr={{1,2,3},{4,2,6},{7,2,5}};
    int max=0;
    int row=-1;
        for(int i=0;i<arr.length;i++){
             int sum=0;
            for(int j=0;j<arr[0].length;j++){
            sum+=arr[i][j];
            }
            if(sum>max){
                max=sum;
                row=i;
            }
        }
        System.out.print( row+" "+max);
}
}
