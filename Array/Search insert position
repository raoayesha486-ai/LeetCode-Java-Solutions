class Main {
    public static void main(String[] args) {
    int [] arr ={1,3,5,6};
    int target=5;
    int start=0;
    int end=arr.length-1;
    while(start<=end){
    int mid=(start+end)/2;
    if(arr[mid]==target){
    System.out.print(mid);
    break;
    }
    else if(target>=arr[mid]){
      start=mid+1;
    }
        else{
         end=mid-1;
        }
    
    }
    }
}
