import java.util.*;

public class Main {
    public static void main(String[] args) {
    int arr[]={5,2,3,1};
    int n=arr.length;
    int i=0;
    int j=n-1;
    for(i=0;i<n;i++){
      for(j=i+1;j<n;j++){
      if(arr[i]>arr[j]){
        int temp=arr[i];
        arr[i]=arr[j];
        arr[j]=temp;
      }
      }
      }
      for (int k = 0; k < n; k++) {
    System.out.print(arr[k] + " ");

    }
    }
}
